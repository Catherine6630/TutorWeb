# Generate a long random value for production (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret
# Leave unset in normal use. Set false only when testing a production build over local HTTP.
SESSION_COOKIE_SECURE=

# The app runs without a key, but AI answers and embeddings require one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local defaults. Paths are relative to the project root.
DATABASE_PATH=./data/tutor.db
UPLOAD_DIR=./storage/materials
NEXT_PUBLIC_APP_NAME=Tutorly

# Upload and request limits.
MAX_UPLOAD_MB=15
AI_DAILY_MESSAGE_LIMIT=100
